ENV=development

# Postgres connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nutripredict

# Change this to a long random value in any real deployment
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Which prediction model is active — see app/services/prediction_engine/registry.py
# "ml" is currently the only registered model (app/services/prediction_engine/ml_model.py)
PREDICTION_MODEL=ml

# Paths to the trained model artifacts. Defaults (computed in
# app/core/config.py) point at app/ml_assets/ where the model files are
# bundled — only set these if you're loading artifacts from elsewhere.
# DIET_MODEL_PATH=
# METABOLIC_MODEL_PATH=
# FOOD_DATABASE_PATH=

# Used to build links inside emails (e.g. the password reset link)
FRONTEND_URL=http://localhost:5173

# "console" (default — logs instead of sending, see app/services/email/)
# "smtp" once app/services/email/smtp_sender.py is filled in and registered
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=no-reply@nutripredict.local

# How long a password reset link stays valid
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
